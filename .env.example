# 한글 요약 모듈이 사용하는 Anthropic API 키.
# 이 파일을 .env로 복사해 값을 채운다. .env는 .gitignore에 있으므로 커밋되지 않는다.
# 키를 public/ 아래 어떤 파일에도 넣지 않는다. 뷰어는 LLM을 직접 호출하지 않는다.
# 비워 두면 요약 없이 원문 제목만 표시된다. 그 상태로도 화면은 정상 동작한다.
LLM_API_KEY=

# 사용할 모델. collector/summarize.js 한 곳에서만 쓴다.
#   claude-haiku-5-5   기본값. 제목 번역과 한 줄 요약에는 이것으로 충분하다 (월 약 $0.7)
#   claude-sonnet-5-5  번역 품질이 모자랄 때 올린다 (월 약 $14)
LLM_MODEL=claude-haiku-5-5

# 하루 요청 수 상한. 기본 100.
# Claude API에는 무료 등급이 없다. 이 값은 "무료 한도"가 아니라 지출 상한이다.
# 배치가 10건이므로 100요청이면 하루 1,000건까지 요약한다.
# 0으로 두면 T1을 제외한 요약을 모두 끈다.
SUMMARY_DAILY_REQUEST_LIMIT=100

# 아래 둘은 보통 건드리지 않는다.
# 사내 게이트웨이를 거칠 때만 엔드포인트를 덮어쓴다.
# LLM_ENDPOINT=
# LLM_API_VERSION=2026-10-21
