# 한글 요약 모듈이 사용하는 LLM API 키.
# 이 파일을 .env로 복사해 값을 채운다. .env는 .gitignore에 있으므로 커밋되지 않는다.
# 키를 public/ 아래 어떤 파일에도 넣지 않는다. 뷰어는 LLM을 직접 호출하지 않는다.
LLM_API_KEY=

# 요약 제공자 설정. collector/summarize.js 한 곳에서만 사용한다.
# 비워 두면 기본값(Google Gemini generateContent)을 사용한다.
LLM_MODEL=gemini-2.5-flash

# 요약 일일 요청 상한. 기본 100회.
SUMMARY_DAILY_REQUEST_LIMIT=100
